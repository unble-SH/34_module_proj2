        "llm_calls": {
          "title": "Llm Calls",
          "type": "integer"
        },
        "cache_hits": {
          "title": "Cache Hits",
          "type": "integer"
        },
        "tokens": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "method",
        "model",
        "prompt_version",
        "generated_at",
        "llm_calls",
        "cache_hits",
        "tokens"
      ],
      "title": "MappingInfo",
      "type": "object"
    },
    "OutputFinding": {
