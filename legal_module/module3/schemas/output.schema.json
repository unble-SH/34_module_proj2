        "violated_laws": {
          "items": {
            "$ref": "#/$defs/ViolatedLaw"
          },
          "title": "Violated Laws",
          "type": "array"
        },
        "isms_p": {
          "items": {
            "$ref": "#/$defs/IsmsPCriterion"
          },
          "title": "Isms P",
          "type": "array"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        }
