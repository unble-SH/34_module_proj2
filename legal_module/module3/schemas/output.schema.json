          "enum": [
            "rule",
            "rule+llm",
            "llm"
          ],
          "title": "Mapped By",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
