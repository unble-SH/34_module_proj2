          "title": "Criterion Id",
          "type": "string"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "mapped_by": {
          "enum": [
            "llm",
            "rule"
          ],
          "title": "Mapped By",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "ref_id",
        "title",
        "text",
        "mapped_by",
        "reviewed",
        "reason"
      ],
      "title": "IsmsPCriterion",
      "type": "object"
    },
    "MappingInfo": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
