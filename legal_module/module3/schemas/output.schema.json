          "type": "integer"
        },
        "prompt_cached": {
          "title": "Prompt Cached",
          "type": "integer"
        },
        "completion": {
          "title": "Completion",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Cost Usd"
        }
      },
      "required": [
        "prompt",
        "prompt_cached",
        "completion",
        "estimated_cost_usd"
      ],
      "title": "TokenUsage",
      "type": "object"
