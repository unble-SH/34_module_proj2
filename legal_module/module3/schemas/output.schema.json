    },
    "mapping": {
      "$ref": "#/$defs/MappingInfo"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/OutputFinding"
      },
      "title": "Findings",
      "type": "array"
    }
