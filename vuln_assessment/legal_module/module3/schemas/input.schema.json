{
  "$defs": {
    "Asset": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "handles_personal_data": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handles Personal Data"
        }
      },
      "title": "Asset",
      "type": "object"
    },
    "InputFinding": {
      "additionalProperties": true,
      "properties": {
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "item_id",
        "title",
        "status"
      ],
      "title": "InputFinding",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "scan_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scan Date"
    },
    "target_system": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target System"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/InputFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "scan_id",
    "findings"
  ],
  "title": "ScanInput",
  "type": "object"
}